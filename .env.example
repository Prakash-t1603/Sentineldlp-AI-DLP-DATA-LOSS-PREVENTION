# SentinelDLP AI - Environment Configuration
PROJECT_NAME="SentinelDLP AI"
VERSION="2.0.0"
DEBUG=True

# Server
API_HOST="127.0.0.1"
API_PORT=8000

# Database Configuration (SQLite default; can point to PostgreSQL)
DATABASE_URL="sqlite:///./sentinel.db"
# Example PostgreSQL: DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/sentineldlp"

# JWT Security
SECRET_KEY="sentineldlp_enterprise_secret_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Endpoint Agent Security
AGENT_SECRET_KEY="sentinel_agent_telemetry_secure_token_key_9981"
BACKEND_URL="http://127.0.0.1:8000/api/v1"

# Monitored and Upload Paths
MONITOR_PATH="./monitored_data"
UPLOAD_PATH="./uploads"
LOG_LEVEL="INFO"

# Default Admin Credentials for initial setup
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@sentineldlp.io"
DEFAULT_ADMIN_PASSWORD="Admin@123456"
